{
  "name": "vhone",
  "displayName": "vhone: VHDL formatter, linter and language server",
  "description": "Formatting, linting, navigation and syntax highlighting for VHDL, powered by the vhone language server.",
  "version": "0.1.1",
  "publisher": "thewenneur",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewenneur/vhone",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/thewenneur/vhone/issues"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "vhdl",
    "fpga",
    "hdl",
    "formatter",
    "linter"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/{vhone,.vhone,vhdl_ls}.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl",
          ".vho",
          ".vht"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "procedure",
        "superType": "function",
        "description": "A VHDL procedure."
      },
      {
        "id": "signal",
        "superType": "variable",
        "description": "A VHDL signal."
      },
      {
        "id": "port",
        "superType": "parameter",
        "description": "A VHDL port; modifiers give its mode."
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "A VHDL constant."
      },
      {
        "id": "generic",
        "superType": "parameter",
        "description": "A VHDL generic constant."
      },
      {
        "id": "label",
        "description": "A VHDL statement label."
      },
      {
        "id": "unit",
        "superType": "enumMember",
        "description": "A VHDL physical unit, like ns."
      },
      {
        "id": "attribute",
        "superType": "property",
        "description": "A user-defined VHDL attribute."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "in",
        "description": "A port or parameter of mode in."
      },
      {
        "id": "out",
        "description": "A port or parameter of mode out."
      },
      {
        "id": "inout",
        "description": "A port or parameter of mode inout."
      },
      {
        "id": "buffer",
        "description": "A port or parameter of mode buffer."
      },
      {
        "id": "linkage",
        "description": "A port or parameter of mode linkage."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vhdl",
        "scopes": {
          "namespace": [
            "entity.name.namespace.vhdl"
          ],
          "type": [
            "entity.name.type.vhdl"
          ],
          "typeParameter": [
            "entity.name.type.parameter.vhdl"
          ],
          "class": [
            "entity.name.type.entity.vhdl"
          ],
          "interface": [
            "entity.name.type.component.vhdl"
          ],
          "function": [
            "entity.name.function.vhdl"
          ],
          "procedure": [
            "entity.name.function.procedure.vhdl"
          ],
          "enumMember": [
            "variable.other.enummember.vhdl"
          ],
          "variable": [
            "variable.other.vhdl"
          ],
          "parameter": [
            "variable.parameter.vhdl"
          ],
          "signal": [
            "variable.other.signal.vhdl"
          ],
          "port": [
            "variable.parameter.port.vhdl"
          ],
          "constant": [
            "variable.other.constant.vhdl"
          ],
          "generic": [
            "variable.other.constant.generic.vhdl"
          ],
          "label": [
            "entity.name.label.vhdl"
          ],
          "unit": [
            "keyword.other.unit.vhdl"
          ],
          "attribute": [
            "entity.other.attribute-name.vhdl"
          ]
        }
      }
    ],
    "configuration": {
      "title": "vhone",
      "properties": {
        "vhone.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `vhone` executable. Leave empty to use `vhone` from `PATH`, or from `~/.cargo/bin`. `~` and `${workspaceFolder}` are expanded."
        },
        "vhone.server.extraEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "machine-overridable",
          "markdownDescription": "Extra environment variables for the language server, such as `{ \"RUST_BACKTRACE\": \"1\" }`."
        },
        "vhone.format.onType": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Format the line you just finished as you type: the line of a `;`, or the line above a new line. A project can turn it off for everyone with `on_type = false` under `[format]` in `vhone.toml`."
        },
        "vhone.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Log the messages between VS Code and the language server to the **vhone Language Server Trace** output."
        }
      }
    },
    "configurationDefaults": {
      "[vhdl]": {
        "editor.defaultFormatter": "thewenneur.vhone",
        "editor.formatOnType": true
      }
    },
    "commands": [
      {
        "command": "vhone.restartServer",
        "title": "Restart Language Server",
        "category": "vhone"
      },
      {
        "command": "vhone.fixAll",
        "title": "Fix All Lint Findings in File",
        "category": "vhone",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vhone.showOutput",
        "title": "Show Language Server Output",
        "category": "vhone"
      },
      {
        "command": "vhone.insertInstance",
        "title": "Insert Entity Instantiation...",
        "category": "vhone",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vhone.insertComponentInstance",
        "title": "Insert Component Instantiation...",
        "category": "vhone",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vhone.insertComponent",
        "title": "Insert Component Declaration...",
        "category": "vhone",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vhone.generateTestbench",
        "title": "Generate Testbench...",
        "category": "vhone"
      },
      {
        "command": "vhone.generateDocs",
        "title": "Generate Documentation",
        "category": "vhone",
        "icon": "$(book)"
      },
      {
        "command": "vhone.showDiagrams",
        "title": "Show Diagrams",
        "category": "vhone",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vhone.fixAll",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vhone.insertInstance",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vhone.insertComponentInstance",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vhone.insertComponent",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vhone.showDiagrams",
          "when": "editorLangId == vhdl"
        }
      ],
      "editor/context": [
        {
          "command": "vhone.insertInstance",
          "when": "editorLangId == vhdl",
          "group": "1_modification@10"
        },
        {
          "command": "vhone.generateTestbench",
          "when": "editorLangId == vhdl",
          "group": "1_modification@11"
        },
        {
          "command": "vhone.showDiagrams",
          "when": "editorLangId == vhdl",
          "group": "1_modification@12"
        }
      ],
      "editor/title": [
        {
          "command": "vhone.showDiagrams",
          "when": "resourceLangId == vhdl && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vhone.generateDocs",
          "when": "explorerResourceIsFolder || resourceLangId == vhdl",
          "group": "7_modification@50"
        },
        {
          "command": "vhone.showDiagrams",
          "when": "resourceLangId == vhdl",
          "group": "7_modification@51"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && node test/e2e/run.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.10",
    "typescript": "~5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
