{
  "name": "vfl",
  "displayName": "vfl: VHDL and Verilog formatter and linter",
  "description": "Formatting, linting, navigation and syntax highlighting for VHDL, Verilog and SystemVerilog, powered by the vfl language server.",
  "version": "0.8.0",
  "publisher": "thewenneur",
  "license": "MIT OR Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewenneur/vhdl-fmt-lint",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/thewenneur/vhdl-fmt-lint/issues"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "vhdl",
    "verilog",
    "systemverilog",
    "fpga",
    "hdl",
    "formatter",
    "linter"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you do not trust, vfl ignores the workspace's `vfl.server.path` and `vfl.server.extraEnv`, so that the workspace cannot choose the program it runs.",
      "restrictedConfigurations": [
        "vfl.server.path",
        "vfl.server.extraEnv"
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:**/{vfl,.vfl,vhdl_ls}.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl",
          ".vho",
          ".vht"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration-verilog.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration-verilog.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vhdl",
        "path": "./snippets/vhdl.json"
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": [
          "vfl.toml",
          ".vfl.toml"
        ],
        "url": "https://raw.githubusercontent.com/thewenneur/vhdl-fmt-lint/v0.8.0/editors/vscode/schemas/vfl.schema.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "procedure",
        "superType": "function",
        "description": "A VHDL procedure."
      },
      {
        "id": "signal",
        "superType": "variable",
        "description": "A VHDL signal, or a Verilog net or module-level variable."
      },
      {
        "id": "port",
        "superType": "parameter",
        "description": "A port; modifiers give its mode or direction."
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "A VHDL constant, or a Verilog localparam."
      },
      {
        "id": "generic",
        "superType": "parameter",
        "description": "A VHDL generic constant, or a Verilog parameter."
      },
      {
        "id": "label",
        "description": "A statement label, or a Verilog instance or block name."
      },
      {
        "id": "unit",
        "superType": "enumMember",
        "description": "A VHDL physical unit, like ns."
      },
      {
        "id": "attribute",
        "superType": "property",
        "description": "A user-defined VHDL attribute."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "in",
        "description": "A port or parameter of mode in."
      },
      {
        "id": "out",
        "description": "A port or parameter of mode out."
      },
      {
        "id": "inout",
        "description": "A port or parameter of mode inout."
      },
      {
        "id": "buffer",
        "description": "A port or parameter of mode buffer."
      },
      {
        "id": "linkage",
        "description": "A port or parameter of mode linkage."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vhdl",
        "scopes": {
          "namespace": [
            "entity.name.namespace.vhdl"
          ],
          "type": [
            "entity.name.type.vhdl"
          ],
          "typeParameter": [
            "entity.name.type.parameter.vhdl"
          ],
          "class": [
            "entity.name.type.entity.vhdl"
          ],
          "interface": [
            "entity.name.type.component.vhdl"
          ],
          "function": [
            "entity.name.function.vhdl"
          ],
          "procedure": [
            "entity.name.function.procedure.vhdl"
          ],
          "enumMember": [
            "variable.other.enummember.vhdl"
          ],
          "variable": [
            "variable.other.vhdl"
          ],
          "parameter": [
            "variable.parameter.vhdl"
          ],
          "signal": [
            "variable.other.signal.vhdl"
          ],
          "port": [
            "variable.parameter.port.vhdl"
          ],
          "constant": [
            "variable.other.constant.vhdl"
          ],
          "generic": [
            "variable.other.constant.generic.vhdl"
          ],
          "label": [
            "entity.name.label.vhdl"
          ],
          "unit": [
            "keyword.other.unit.vhdl"
          ],
          "attribute": [
            "entity.other.attribute-name.vhdl"
          ]
        }
      },
      {
        "language": "verilog",
        "scopes": {
          "namespace": [
            "entity.name.namespace.systemverilog"
          ],
          "type": [
            "entity.name.type.systemverilog"
          ],
          "typeParameter": [
            "entity.name.type.parameter.systemverilog"
          ],
          "class": [
            "entity.name.type.entity.systemverilog"
          ],
          "interface": [
            "entity.name.type.component.systemverilog"
          ],
          "function": [
            "entity.name.function.systemverilog"
          ],
          "procedure": [
            "entity.name.function.procedure.systemverilog"
          ],
          "enumMember": [
            "variable.other.enummember.systemverilog"
          ],
          "variable": [
            "variable.other.systemverilog"
          ],
          "parameter": [
            "variable.parameter.systemverilog"
          ],
          "signal": [
            "variable.other.signal.systemverilog"
          ],
          "port": [
            "variable.parameter.port.systemverilog"
          ],
          "constant": [
            "variable.other.constant.systemverilog"
          ],
          "generic": [
            "variable.other.constant.generic.systemverilog"
          ],
          "label": [
            "entity.name.label.systemverilog"
          ],
          "unit": [
            "keyword.other.unit.systemverilog"
          ],
          "attribute": [
            "entity.other.attribute-name.systemverilog"
          ]
        }
      },
      {
        "language": "systemverilog",
        "scopes": {
          "namespace": [
            "entity.name.namespace.systemverilog"
          ],
          "type": [
            "entity.name.type.systemverilog"
          ],
          "typeParameter": [
            "entity.name.type.parameter.systemverilog"
          ],
          "class": [
            "entity.name.type.entity.systemverilog"
          ],
          "interface": [
            "entity.name.type.component.systemverilog"
          ],
          "function": [
            "entity.name.function.systemverilog"
          ],
          "procedure": [
            "entity.name.function.procedure.systemverilog"
          ],
          "enumMember": [
            "variable.other.enummember.systemverilog"
          ],
          "variable": [
            "variable.other.systemverilog"
          ],
          "parameter": [
            "variable.parameter.systemverilog"
          ],
          "signal": [
            "variable.other.signal.systemverilog"
          ],
          "port": [
            "variable.parameter.port.systemverilog"
          ],
          "constant": [
            "variable.other.constant.systemverilog"
          ],
          "generic": [
            "variable.other.constant.generic.systemverilog"
          ],
          "label": [
            "entity.name.label.systemverilog"
          ],
          "unit": [
            "keyword.other.unit.systemverilog"
          ],
          "attribute": [
            "entity.other.attribute-name.systemverilog"
          ]
        }
      }
    ],
    "configuration": {
      "title": "vfl",
      "properties": {
        "vfl.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `vfl` executable. Leave empty to use `vfl` from `PATH`, or from `~/.cargo/bin`, or else the release binary of the extension's version, which the extension offers to download. `~` and `${workspaceFolder}` are expanded. Ignored in workspaces you do not trust, when set by the workspace."
        },
        "vfl.server.extraEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "machine-overridable",
          "markdownDescription": "Extra environment variables for the language server, such as `{ \"RUST_BACKTRACE\": \"1\" }`. Ignored in workspaces you do not trust, when set by the workspace."
        },
        "vfl.lint.preset": {
          "type": "string",
          "enum": [
            "none",
            "recommended",
            "strict"
          ],
          "enumDescriptions": [
            "Only syntax errors.",
            "Likely bugs.",
            "Every rule except the naming conventions."
          ],
          "default": "recommended",
          "scope": "window",
          "markdownDescription": "The lint preset of projects without a `vfl.toml`. A `vfl.toml` replaces this setting and `#vfl.format.style#`; **vfl: Generate Project Config (vfl.toml)** writes one from them."
        },
        "vfl.format.style": {
          "type": "string",
          "enum": [
            "default",
            "leading-comma",
            "compact",
            "classic"
          ],
          "enumDescriptions": [
            "The defaults of every key.",
            "`,` and `;` start the next line instead of ending the line; maps one element per line.",
            "Lists stay on one line when they fit; only trailing comments are aligned.",
            "Upper case keywords, `end` repeating the construct keyword and name, maps one element per line."
          ],
          "default": "default",
          "scope": "window",
          "markdownDescription": "The format style of projects without a `vfl.toml`. A `vfl.toml` replaces this setting and `#vfl.lint.preset#`; **vfl: Generate Project Config (vfl.toml)** writes one from them."
        },
        "vfl.format.onType": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Format the line you just finished as you type: the line of a `;`, or the line above a new line. A project can turn it off for everyone with `on_type = false` under `[format]` in `vfl.toml`."
        },
        "vfl.hierarchy.top": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "The top entity of the **VHDL Hierarchy** view, as `name` or `library.name`. Empty: every entity no other entity instantiates. **Select Top Entity** in the view sets it for the workspace."
        },
        "vfl.hierarchy.testbenches": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Without `#vfl.hierarchy.top#`, start the **VHDL Hierarchy** view from testbenches (entities without ports) too. Off, it starts from what they test."
        },
        "vfl.inlayHints.ports": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show the port name before each positional actual of a port map. Unless set here, `ports` under `[lsp.inlay_hints]` in `vfl.toml` decides. `#editor.inlayHints.enabled#` turns every inlay hint off."
        },
        "vfl.inlayHints.generics": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show the generic name before each positional actual of a generic map. Unless set here, `generics` under `[lsp.inlay_hints]` in `vfl.toml` decides."
        },
        "vfl.inlayHints.parameters": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show the parameter name before each positional argument of a function or procedure call. Unless set here, `parameters` under `[lsp.inlay_hints]` in `vfl.toml` decides."
        },
        "vfl.inlayHints.portTypes": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Show the mode and type of the port after each actual of a port map. Unless set here, `port_types` under `[lsp.inlay_hints]` in `vfl.toml` decides."
        },
        "vfl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Log the messages between VS Code and the language server to the **vfl Language Server Trace** output."
        }
      }
    },
    "configurationDefaults": {
      "[vhdl]": {
        "editor.defaultFormatter": "thewenneur.vfl",
        "editor.formatOnType": true
      },
      "[verilog]": {
        "editor.defaultFormatter": "thewenneur.vfl",
        "editor.formatOnType": true
      },
      "[systemverilog]": {
        "editor.defaultFormatter": "thewenneur.vfl",
        "editor.formatOnType": true
      }
    },
    "commands": [
      {
        "command": "vfl.restartServer",
        "title": "Restart Language Server",
        "category": "vfl"
      },
      {
        "command": "vfl.fixAll",
        "title": "Fix All Lint Findings in File",
        "category": "vfl",
        "enablement": "editorLangId =~ /^(vhdl|verilog|systemverilog)$/"
      },
      {
        "command": "vfl.toggleFormatOnType",
        "title": "Toggle Format on Type",
        "category": "vfl"
      },
      {
        "command": "vfl.showOutput",
        "title": "Show Language Server Output",
        "category": "vfl"
      },
      {
        "command": "vfl.insertInstance",
        "title": "Insert Entity Instantiation...",
        "category": "vfl",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vfl.insertComponentInstance",
        "title": "Insert Component Instantiation...",
        "category": "vfl",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vfl.insertComponent",
        "title": "Insert Component Declaration...",
        "category": "vfl",
        "enablement": "editorLangId == vhdl"
      },
      {
        "command": "vfl.generateTestbench",
        "title": "Generate Testbench...",
        "category": "vfl"
      },
      {
        "command": "vfl.generateConfig",
        "title": "Generate Project Config (vfl.toml)",
        "category": "vfl"
      },
      {
        "command": "vfl.generateDocs",
        "title": "Generate Documentation",
        "category": "vfl",
        "icon": "$(book)"
      },
      {
        "command": "vfl.generateSpec",
        "title": "Generate Specification",
        "category": "vfl"
      },
      {
        "command": "vfl.showDiagrams",
        "title": "Show Diagrams",
        "category": "vfl",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "vfl.hierarchy.refresh",
        "title": "Refresh Hierarchy",
        "category": "vfl",
        "icon": "$(refresh)"
      },
      {
        "command": "vfl.hierarchy.selectTop",
        "title": "Select Hierarchy Top...",
        "category": "vfl",
        "icon": "$(target)"
      },
      {
        "command": "vfl.hierarchy.setTop",
        "title": "Set as Top",
        "category": "vfl"
      },
      {
        "command": "vfl.hierarchy.openEntity",
        "title": "Open Entity",
        "category": "vfl"
      },
      {
        "command": "vfl.hierarchy.openArchitecture",
        "title": "Open Architecture",
        "category": "vfl"
      },
      {
        "command": "vfl.hierarchy.generateTestbench",
        "title": "Generate Testbench",
        "category": "vfl"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vfl.fixAll",
          "when": "editorLangId =~ /^(vhdl|verilog|systemverilog)$/"
        },
        {
          "command": "vfl.insertInstance",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vfl.insertComponentInstance",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vfl.insertComponent",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vfl.showDiagrams",
          "when": "editorLangId == vhdl"
        },
        {
          "command": "vfl.hierarchy.setTop",
          "when": "false"
        },
        {
          "command": "vfl.hierarchy.openEntity",
          "when": "false"
        },
        {
          "command": "vfl.hierarchy.openArchitecture",
          "when": "false"
        },
        {
          "command": "vfl.hierarchy.generateTestbench",
          "when": "false"
        },
        {
          "command": "vfl.hierarchy.refresh",
          "when": "vfl.active"
        },
        {
          "command": "vfl.hierarchy.selectTop",
          "when": "vfl.active"
        }
      ],
      "editor/context": [
        {
          "command": "vfl.insertInstance",
          "when": "editorLangId == vhdl",
          "group": "1_modification@10"
        },
        {
          "command": "vfl.generateTestbench",
          "when": "editorLangId == vhdl",
          "group": "1_modification@11"
        },
        {
          "command": "vfl.showDiagrams",
          "when": "editorLangId == vhdl",
          "group": "1_modification@12"
        }
      ],
      "editor/title": [
        {
          "command": "vfl.showDiagrams",
          "when": "resourceLangId == vhdl && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vfl.generateDocs",
          "when": "explorerResourceIsFolder || resourceLangId == vhdl",
          "group": "7_modification@50"
        },
        {
          "command": "vfl.showDiagrams",
          "when": "resourceLangId == vhdl",
          "group": "7_modification@51"
        },
        {
          "command": "vfl.generateSpec",
          "when": "explorerResourceIsFolder || resourceLangId == vhdl",
          "group": "7_modification@52"
        }
      ],
      "view/title": [
        {
          "command": "vfl.hierarchy.selectTop",
          "when": "view == vfl.hierarchy",
          "group": "navigation@1"
        },
        {
          "command": "vfl.hierarchy.refresh",
          "when": "view == vfl.hierarchy",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vfl.hierarchy.openEntity",
          "when": "view == vfl.hierarchy && viewItem == entity",
          "group": "navigation@1"
        },
        {
          "command": "vfl.hierarchy.openArchitecture",
          "when": "view == vfl.hierarchy && viewItem == entity",
          "group": "navigation@2"
        },
        {
          "command": "vfl.hierarchy.setTop",
          "when": "view == vfl.hierarchy && viewItem == entity",
          "group": "2_top@1"
        },
        {
          "command": "vfl.hierarchy.generateTestbench",
          "when": "view == vfl.hierarchy && viewItem == entity",
          "group": "3_generate@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "vfl.hierarchy",
          "name": "VHDL Hierarchy",
          "when": "vfl.active",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "vfl"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && node test/e2e/run.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.10",
    "typescript": "~5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
