---
source: crates/vfl-fmt/tests/format.rs
expression: fmt(&text)
input_file: crates/vfl-fmt/tests/data/alignment.vhd
---
entity uart_tx is
  generic (
    CLK_FREQ  : natural := 100_000_000; -- system clock in Hz
    BAUD      : natural := 115_200;     -- line rate
    PARITY_EN : boolean := false
  );
  port (
    clk   : in std_logic; -- clock
    rst_n : in std_logic; -- active-low reset

    data  : in     std_logic_vector(7 downto 0);
    valid : in     std_logic;
    ready : out    std_logic;
    tx    : out    std_logic;
    busy  : buffer std_logic := '0'
  );
end entity;

architecture rtl of uart_tx is
  constant DIVISOR : natural                      := CLK_FREQ / BAUD;
  signal shreg     : std_logic_vector(9 downto 0) := (others => '1');
  signal bit_count : unsigned(3 downto 0);
  -- a comment inside the run
  signal tick      : std_logic;

  type state_t      is (IDLE, SEND);
  subtype divider_t is natural range 0 to DIVISOR - 1;
  signal state : state_t;
begin
  ready <= not busy;
  tx    <= shreg(0);
  busy  <= '1' when state = SEND else '0';

  with state select
    led <= "01" when IDLE,
           "10" when SEND,
           "00" when others;

  status <= "000" when bit_count = 0 else
            "001" when bit_count < 4 else
            "010";

  fsm : process (clk) is
  begin
    if rising_edge(clk) then
      case state is
        when IDLE   => state     <= SEND;          -- start
        when SEND   => bit_count <= bit_count + 1; -- shift
        when others => state     <= IDLE;
      end case;
    end if;
  end process;

  u_div : entity work.divider
    generic map (WIDTH => 16, START => 0)
    port map (
      clk     => clk,
      reset_n => rst_n,
      tick    => tick
    );
end architecture;
